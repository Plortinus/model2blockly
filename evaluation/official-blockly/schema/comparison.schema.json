{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model2blockly.local/schema/comparison.schema.json",
  "title": "Property-level comparison of an official editor and Model2Blockly",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "baselineTreatment", "actualTreatment", "editor", "generators"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "caseId": { "type": "string", "minLength": 1 },
    "baselineTreatment": { "const": "baseline" },
    "actualTreatment": { "const": "m2b" },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "loadErrors", "properties"],
      "properties": {
        "summary": {
          "allOf": [
            { "$ref": "#/$defs/summary" },
            {
              "type": "object",
              "required": ["classification"],
              "properties": {
                "classification": { "enum": ["complete", "partial", "not-reproducible"] }
              }
            }
          ]
        },
        "loadErrors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/property" }
        }
      }
    },
    "generators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "summary", "properties"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "summary": { "$ref": "#/$defs/summary" },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/property" }
        }
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalObserved",
        "applicable",
        "matches",
        "partial",
        "mismatches",
        "unsupported",
        "errors",
        "excluded",
        "differences",
        "parityPercent"
      ],
      "properties": {
        "totalObserved": { "type": "integer", "minimum": 0 },
        "applicable": { "type": "integer", "minimum": 0 },
        "matches": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "mismatches": { "type": "integer", "minimum": 0 },
        "unsupported": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "differences": { "type": "integer", "minimum": 0 },
        "parityPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "classification": { "enum": ["complete", "partial", "not-reproducible"] }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "status", "expected", "actual"],
      "properties": {
        "property": { "type": "string", "minLength": 1 },
        "status": { "enum": ["match", "partial", "mismatch", "unsupported", "excluded", "error"] },
        "expected": true,
        "actual": true,
        "capability": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "boundary": { "enum": ["model2blockly", "domain-runtime", "host-application"] },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["partial", "mismatch", "unsupported", "excluded"] }
            }
          },
          "then": {
            "properties": {
              "capability": true,
              "boundary": true,
              "rationale": true
            },
            "required": ["capability", "boundary", "rationale"]
          }
        },
        {
          "if": { "properties": { "status": { "const": "error" } } },
          "then": {
            "properties": { "rationale": true },
            "required": ["rationale"]
          }
        }
      ]
    }
  }
}
