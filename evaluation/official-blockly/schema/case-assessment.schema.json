{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model2blockly.local/schema/case-assessment.schema.json",
  "title": "Documented classification rules for one evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section",
          "propertyPattern",
          "status",
          "capability",
          "boundary",
          "rationale"
        ],
        "properties": {
          "section": { "enum": ["editor", "generators"] },
          "propertyPattern": { "type": "string", "minLength": 1 },
          "status": { "enum": ["partial", "mismatch", "unsupported", "excluded"] },
          "capability": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "boundary": { "enum": ["model2blockly", "domain-runtime", "host-application"] },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
