{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model2blockly.local/schema/baseline-extraction.schema.json",
  "title": "Traceable extraction of an official Blockly baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "configuration", "source", "fragments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "configuration": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "license"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fragment" }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "snapshotPath", "sha256", "mediaType", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "snapshotPath": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mediaType": { "type": "string", "minLength": 1 },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "startLine",
        "endLine",
        "sha256",
        "kinds",
        "metricGroups",
        "countForMetrics",
        "sharedSourceKey",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "snapshotPath": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "block-definition",
              "toolbox",
              "generator",
              "editor-extension",
              "initial-workspace",
              "custom-field",
              "domain-runtime"
            ]
          }
        },
        "metricGroups": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["editor", "generator"] }
        },
        "countForMetrics": { "type": "boolean" },
        "sharedSourceKey": { "type": ["string", "null"] },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
