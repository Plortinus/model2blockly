<?xml version="1.0" encoding="UTF-8"?>
<blocklyspec:EditorSpec xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:blocklyspec="http://www.example.org/model2blockly/intermediate/BlocklyEditorSpec" domainName="Pond" nsURI="http://www.example.org/pond" nsPrefix="pond" toolboxType="category" codeLanguage="javascript" codeFileExtension="js">
  <categories name="Pond" label="Pond" colour="290"/>
  <categories name="Logic" label="Logic" colour="210"/>
  <categories name="Loops" label="Loops" colour="120"/>
  <categories name="Math" label="Math" colour="230"/>
  <categories name="Variables" label="Variables" colour="330"/>
  <categories name="Functions" label="Functions" colour="290"/>
  <blockTypes typeName="PondCommand" label="PondCommand" abstract="true" connectionType="TYPED" connectionTypeName="PondCommand" inputsInline="true"/>
  <blockTypes typeName="Number" label="Number" abstract="true" connectionType="OUTPUT" outputType="Number" inputsInline="true"/>
  <blockTypes typeName="Boolean" label="Boolean" abstract="true" connectionType="OUTPUT" outputType="Boolean" inputsInline="true"/>
  <blockTypes typeName="pond_scan" label="scan" colour="290" categoryName="Pond" superTypeName="Number" connectionType="OUTPUT_TYPED" outputType="Number" message0="%1(%2)" inputsInline="true" tooltip="Scan for enemies. Specify a direction (0-360). Returns the distance to the closest enemy in that direction. Returns Infinity if no enemy found." codeTemplate="scan({{value:DEGREE}})">
    <orderedInputNames>CALL</orderedInputNames>
    <orderedInputNames>DEGREE</orderedInputNames>
    <fields name="CALL" fieldType="LABEL" defaultValue="scan" uiWidget="text" uiLabel="Function" uiOrder="1" uiReadonly="true" uiVariant="default"/>
    <valueInputs name="DEGREE" checkType="Number" shadowBlockType="pond_math_number" uiWidget="expression-slot" uiLabel="Direction" uiOrder="2" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="pond_cannon" label="cannon" colour="290" categoryName="Pond" superTypeName="PondCommand" connectionType="TYPED" connectionTypeName="PondCommand" message0="%1(%2, %3);" inputsInline="true" tooltip="Fire the cannon. Specify a direction (0-360) and a range (0-70)." codeTemplate="cannon({{value:DEGREE}}, {{value:RANGE}});">
    <orderedInputNames>CALL</orderedInputNames>
    <orderedInputNames>DEGREE</orderedInputNames>
    <orderedInputNames>RANGE</orderedInputNames>
    <fields name="CALL" fieldType="LABEL" defaultValue="cannon" uiWidget="text" uiLabel="Function" uiOrder="1" uiReadonly="true" uiVariant="default"/>
    <valueInputs name="DEGREE" checkType="Number" shadowBlockType="pond_math_number" uiWidget="expression-slot" uiLabel="Direction" uiOrder="2" uiVariant="default"/>
    <valueInputs name="RANGE" checkType="Number" shadowBlockType="pond_math_number" uiWidget="expression-slot" uiLabel="Range" uiOrder="3" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="pond_swim" label="swim" colour="290" categoryName="Pond" superTypeName="PondCommand" connectionType="TYPED" connectionTypeName="PondCommand" message0="%1(%2);" inputsInline="true" tooltip="Swim forward. Specify a direction (0-360)." codeTemplate="swim({{value:DEGREE}});">
    <orderedInputNames>CALL</orderedInputNames>
    <orderedInputNames>DEGREE</orderedInputNames>
    <fields name="CALL" fieldType="LABEL" defaultValue="swim" uiWidget="text" uiLabel="Function" uiOrder="1" uiReadonly="true" uiVariant="default"/>
    <valueInputs name="DEGREE" checkType="Number" shadowBlockType="pond_math_number" uiWidget="expression-slot" uiLabel="Direction" uiOrder="2" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="pond_stop" label="stop" colour="290" categoryName="Pond" superTypeName="PondCommand" connectionType="TYPED" connectionTypeName="PondCommand" message0="%1(%2);" inputsInline="false" tooltip="Stop swimming. Player will slow to a stop." codeTemplate="stop();">
    <orderedInputNames>CALL</orderedInputNames>
    <orderedInputNames>EMPTY</orderedInputNames>
    <fields name="CALL" fieldType="LABEL" defaultValue="stop" uiWidget="text" uiLabel="Function" uiOrder="1" uiReadonly="true" uiVariant="default"/>
    <fields name="EMPTY" fieldType="LABEL" defaultValue="" uiWidget="text" uiLabel="Empty argument" uiOrder="2" uiReadonly="true" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="pond_health" label="health" colour="290" categoryName="Pond" superTypeName="Number" connectionType="OUTPUT_TYPED" outputType="Number" message0="%1(%2)" inputsInline="false" tooltip="Returns the player's current health (0 is dead, 100 is healthy)." codeTemplate="health()">
    <orderedInputNames>CALL</orderedInputNames>
    <orderedInputNames>EMPTY</orderedInputNames>
    <fields name="CALL" fieldType="LABEL" defaultValue="health" uiWidget="text" uiLabel="Function" uiOrder="1" uiReadonly="true" uiVariant="default"/>
    <fields name="EMPTY" fieldType="LABEL" defaultValue="" uiWidget="text" uiLabel="Empty argument" uiOrder="2" uiReadonly="true" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="pond_speed" label="speed" colour="290" categoryName="Pond" superTypeName="Number" connectionType="OUTPUT_TYPED" outputType="Number" message0="%1(%2)" inputsInline="false" tooltip="Returns the current speed of the player (0 is stopped, 100 is full speed)." codeTemplate="speed()">
    <orderedInputNames>CALL</orderedInputNames>
    <orderedInputNames>EMPTY</orderedInputNames>
    <fields name="CALL" fieldType="LABEL" defaultValue="speed" uiWidget="text" uiLabel="Function" uiOrder="1" uiReadonly="true" uiVariant="default"/>
    <fields name="EMPTY" fieldType="LABEL" defaultValue="" uiWidget="text" uiLabel="Empty argument" uiOrder="2" uiReadonly="true" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="pond_getX" label="getX" colour="290" categoryName="Pond" superTypeName="Number" connectionType="OUTPUT_TYPED" outputType="Number" message0="%1(%2)" inputsInline="false" tooltip="Returns the X coordinate of the player (0 is the left edge, 100 is the right edge)." codeTemplate="getX()">
    <orderedInputNames>CALL</orderedInputNames>
    <orderedInputNames>EMPTY</orderedInputNames>
    <fields name="CALL" fieldType="LABEL" defaultValue="getX" uiWidget="text" uiLabel="Function" uiOrder="1" uiReadonly="true" uiVariant="default"/>
    <fields name="EMPTY" fieldType="LABEL" defaultValue="" uiWidget="text" uiLabel="Empty argument" uiOrder="2" uiReadonly="true" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="pond_getY" label="getY" colour="290" categoryName="Pond" superTypeName="Number" connectionType="OUTPUT_TYPED" outputType="Number" message0="%1(%2)" inputsInline="false" tooltip="Returns the Y coordinate of the player (0 is the bottom edge, 100 is the top edge)." codeTemplate="getY()">
    <orderedInputNames>CALL</orderedInputNames>
    <orderedInputNames>EMPTY</orderedInputNames>
    <fields name="CALL" fieldType="LABEL" defaultValue="getY" uiWidget="text" uiLabel="Function" uiOrder="1" uiReadonly="true" uiVariant="default"/>
    <fields name="EMPTY" fieldType="LABEL" defaultValue="" uiWidget="text" uiLabel="Empty argument" uiOrder="2" uiReadonly="true" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="pond_log" label="log" colour="290" categoryName="Pond" superTypeName="PondCommand" connectionType="TYPED" connectionTypeName="PondCommand" message0="%1(%2);" inputsInline="true" tooltip="Prints a number to your browser's console." codeTemplate="log({{value:VALUE}});">
    <orderedInputNames>CALL</orderedInputNames>
    <orderedInputNames>VALUE</orderedInputNames>
    <fields name="CALL" fieldType="LABEL" defaultValue="log" uiWidget="text" uiLabel="Function" uiOrder="1" uiReadonly="true" uiVariant="default"/>
    <valueInputs name="VALUE" checkType="Number" shadowBlockType="pond_math_number" uiWidget="expression-slot" uiLabel="Value" uiOrder="2" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="controls_if" label="if" colour="210" categoryName="Logic" superTypeName="PondCommand" connectionType="TYPED" connectionTypeName="PondCommand" message0="if (%1) {%2}" inputsInline="true" tooltip="If a value is true, then do some statements." helpUrl="https://github.com/RaspberryPiFoundation/blockly/wiki/IfElse" codeTemplate="if ({{value:IF0}}) {&#xA;{{statements:DO0}}&#xA;}">
    <orderedInputNames>IF0</orderedInputNames>
    <orderedInputNames>DO0</orderedInputNames>
    <statementInputs name="DO0" checkType="PondCommand" upperBound="50" uiWidget="slot" uiLabel="Do" uiOrder="2" uiVariant="default"/>
    <valueInputs name="IF0" checkType="Boolean" uiWidget="expression-slot" uiLabel="Condition" uiOrder="1" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="logic_compare" label="compare" colour="210" categoryName="Logic" superTypeName="Boolean" connectionType="OUTPUT_TYPED" outputType="Boolean" message0="%1 %2 %3" inputsInline="true" tooltip="Return true if both inputs equal each other." helpUrl="https://en.wikipedia.org/wiki/Inequality_(mathematics)" codeTemplate="{{value:A}} {{OP}} {{value:B}}">
    <orderedInputNames>A</orderedInputNames>
    <orderedInputNames>OP</orderedInputNames>
    <orderedInputNames>B</orderedInputNames>
    <fields name="OP" fieldType="DROPDOWN" defaultValue="EQ" uiWidget="select" uiLabel="Operator" uiOrder="2" uiVariant="default">
      <options value="EQ" label="=="/>
      <options value="NEQ" label="!="/>
      <options value="LT" label="‏&lt;"/>
      <options value="LTE" label="‏&lt;="/>
      <options value="GT" label="‏>"/>
      <options value="GTE" label="‏>="/>
    </fields>
    <valueInputs name="A" checkType="Number" uiWidget="expression-slot" uiLabel="Left operand" uiOrder="1" uiVariant="default"/>
    <valueInputs name="B" checkType="Number" uiWidget="expression-slot" uiLabel="Right operand" uiOrder="3" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="logic_operation" label="logical operation" colour="210" categoryName="Logic" superTypeName="Boolean" connectionType="OUTPUT_TYPED" outputType="Boolean" message0="%1 %2 %3" inputsInline="true" tooltip="Return true if both inputs are true." helpUrl="https://github.com/RaspberryPiFoundation/blockly/wiki/Logic#logical-operations" codeTemplate="{{value:A}} {{OP}} {{value:B}}">
    <orderedInputNames>A</orderedInputNames>
    <orderedInputNames>OP</orderedInputNames>
    <orderedInputNames>B</orderedInputNames>
    <fields name="OP" fieldType="DROPDOWN" defaultValue="AND" uiWidget="select" uiLabel="Operator" uiOrder="2" uiVariant="default">
      <options value="AND" label="&amp;&amp;"/>
      <options value="OR" label="||"/>
    </fields>
    <valueInputs name="A" checkType="Boolean" uiWidget="expression-slot" uiLabel="Left operand" uiOrder="1" uiVariant="default"/>
    <valueInputs name="B" checkType="Boolean" uiWidget="expression-slot" uiLabel="Right operand" uiOrder="3" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="logic_boolean" label="boolean" colour="210" categoryName="Logic" superTypeName="Boolean" connectionType="OUTPUT_TYPED" outputType="Boolean" message0="%1" inputsInline="false" tooltip="Returns either true or false." helpUrl="https://github.com/RaspberryPiFoundation/blockly/wiki/Logic#values" codeTemplate="{{BOOL}}">
    <orderedInputNames>BOOL</orderedInputNames>
    <fields name="BOOL" fieldType="DROPDOWN" defaultValue="TRUE" uiWidget="select" uiLabel="Boolean" uiOrder="1" uiVariant="default">
      <options value="TRUE" label="true"/>
      <options value="FALSE" label="false"/>
    </fields>
  </blockTypes>
  <blockTypes typeName="controls_whileUntil" label="while" colour="120" categoryName="Loops" superTypeName="PondCommand" connectionType="TYPED" connectionTypeName="PondCommand" message0="while (%1) {%2}" inputsInline="true" tooltip="While a value is true, then do some statements." helpUrl="https://github.com/RaspberryPiFoundation/blockly/wiki/Loops#repeat" codeTemplate="while ({{value:BOOL}}) {&#xA;{{statements:DO}}&#xA;}">
    <orderedInputNames>BOOL</orderedInputNames>
    <orderedInputNames>DO</orderedInputNames>
    <statementInputs name="DO" checkType="PondCommand" upperBound="50" uiWidget="slot" uiLabel="Do" uiOrder="2" uiVariant="default"/>
    <valueInputs name="BOOL" checkType="Boolean" uiWidget="expression-slot" uiLabel="Condition" uiOrder="1" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="pond_math_number" label="number or angle" colour="230" categoryName="Math" superTypeName="Number" connectionType="OUTPUT_TYPED" outputType="Number" message0="%1" inputsInline="false" tooltip="A number." helpUrl="https://en.wikipedia.org/wiki/Number" codeTemplate="{{NUM}}">
    <orderedInputNames>NUM</orderedInputNames>
    <fields name="NUM" fieldType="FLOAT" defaultValue="0" uiWidget="number" uiLabel="Number" uiOrder="1" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="math_arithmetic" label="arithmetic" colour="230" categoryName="Math" superTypeName="Number" connectionType="OUTPUT_TYPED" outputType="Number" message0="%1 %2 %3" inputsInline="true" tooltip="Return the sum of the two numbers." helpUrl="https://en.wikipedia.org/wiki/Arithmetic" codeTemplate="{{value:A}} {{OP}} {{value:B}}">
    <orderedInputNames>A</orderedInputNames>
    <orderedInputNames>OP</orderedInputNames>
    <orderedInputNames>B</orderedInputNames>
    <fields name="OP" fieldType="DROPDOWN" defaultValue="ADD" uiWidget="select" uiLabel="Operator" uiOrder="2" uiVariant="default">
      <options value="ADD" label="+"/>
      <options value="MINUS" label="-"/>
      <options value="MULTIPLY" label="*"/>
      <options value="DIVIDE" label="/"/>
    </fields>
    <valueInputs name="A" checkType="Number" shadowBlockType="pond_math_number" uiWidget="expression-slot" uiLabel="Left operand" uiOrder="1" uiVariant="default"/>
    <valueInputs name="B" checkType="Number" shadowBlockType="pond_math_number" uiWidget="expression-slot" uiLabel="Right operand" uiOrder="3" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="pond_math_single" label="advanced math" colour="230" categoryName="Math" superTypeName="Number" connectionType="OUTPUT_TYPED" outputType="Number" message0="%1 (%2)" inputsInline="true" tooltip="Return the square root of a number." helpUrl="https://en.wikipedia.org/wiki/Square_root" codeTemplate="Math.{{OP}}({{value:NUM}})">
    <orderedInputNames>OP</orderedInputNames>
    <orderedInputNames>NUM</orderedInputNames>
    <fields name="OP" fieldType="DROPDOWN" defaultValue="ROOT" uiWidget="select" uiLabel="Function" uiOrder="1" uiVariant="default">
      <options value="ROOT" label="Math.sqrt"/>
      <options value="ABS" label="Math.abs"/>
      <options value="SIN" label="Math.sin_deg"/>
      <options value="COS" label="Math.cos_deg"/>
      <options value="TAN" label="Math.tan_deg"/>
      <options value="ASIN" label="Math.asin_deg"/>
      <options value="ACOS" label="Math.acos_deg"/>
      <options value="ATAN" label="Math.atan_deg"/>
    </fields>
    <valueInputs name="NUM" checkType="Number" shadowBlockType="pond_math_number" uiWidget="expression-slot" uiLabel="Operand" uiOrder="2" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="math_random_float" label="random fraction" colour="230" categoryName="Math" superTypeName="Number" connectionType="OUTPUT_TYPED" outputType="Number" message0="Math.random  (  )" inputsInline="false" tooltip="Return a random fraction between 0.0 (inclusive) and 1.0 (exclusive)." helpUrl="https://en.wikipedia.org/wiki/Random_number_generation" codeTemplate="Math.random()"/>
  <blockTypes typeName="math_change" label="change variable" colour="330" categoryName="Variables" superTypeName="PondCommand" connectionType="TYPED" connectionTypeName="PondCommand" message0="%1 += %2;" inputsInline="true" tooltip="Add a number to variable 'name'." helpUrl="https://en.wikipedia.org/wiki/Programming_idiom#Incrementing_a_counter" codeTemplate="{{VAR}} += {{value:DELTA}};">
    <orderedInputNames>VAR</orderedInputNames>
    <orderedInputNames>DELTA</orderedInputNames>
    <fields name="VAR" defaultValue="name" uiWidget="text" uiLabel="Variable" uiOrder="1" uiVariant="default"/>
    <valueInputs name="DELTA" checkType="Number" shadowBlockType="pond_math_number" uiWidget="expression-slot" uiLabel="Delta" uiOrder="2" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="variables_set" label="set variable" colour="330" categoryName="Variables" superTypeName="PondCommand" connectionType="TYPED" connectionTypeName="PondCommand" message0="var %1 = %2;" inputsInline="true" tooltip="Sets this variable to be equal to the input." helpUrl="https://github.com/RaspberryPiFoundation/blockly/wiki/Variables#set" codeTemplate="var {{VAR}} = {{value:VALUE}};">
    <orderedInputNames>VAR</orderedInputNames>
    <orderedInputNames>VALUE</orderedInputNames>
    <fields name="VAR" defaultValue="name" uiWidget="text" uiLabel="Variable" uiOrder="1" uiVariant="default"/>
    <valueInputs name="VALUE" checkType="Number" uiWidget="expression-slot" uiLabel="Value" uiOrder="2" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="procedures_defnoreturn" label="function definition" colour="290" categoryName="Functions" connectionType="NONE" message0="%1 %2 %3%4%5%6%7" inputsInline="false" tooltip="Creates a function with no output." helpUrl="https://en.wikipedia.org/wiki/Subroutine" codeTemplate="function {{NAME}}({{PARAMS}}) {&#xA;{{statements:STACK}}&#xA;}">
    <orderedInputNames>FUNCTION</orderedInputNames>
    <orderedInputNames>NAME</orderedInputNames>
    <orderedInputNames>OPEN</orderedInputNames>
    <orderedInputNames>PARAMS</orderedInputNames>
    <orderedInputNames>BODY</orderedInputNames>
    <orderedInputNames>STACK</orderedInputNames>
    <orderedInputNames>CLOSE</orderedInputNames>
    <fields name="FUNCTION" fieldType="LABEL" defaultValue="function" uiWidget="text" uiLabel="Keyword" uiOrder="1" uiReadonly="true" uiVariant="default"/>
    <fields name="NAME" defaultValue="" uiWidget="text" uiLabel="Name" uiOrder="2" uiVariant="default"/>
    <fields name="OPEN" fieldType="LABEL" defaultValue="(" uiWidget="text" uiLabel="Open parenthesis" uiOrder="3" uiReadonly="true" uiVariant="default"/>
    <fields name="PARAMS" fieldType="LABEL" defaultValue="" uiWidget="text" uiLabel="Parameters" uiOrder="4" uiReadonly="true" uiVariant="default"/>
    <fields name="BODY" fieldType="LABEL" defaultValue=") {" uiWidget="text" uiLabel="Body start" uiOrder="5" uiReadonly="true" uiVariant="default"/>
    <fields name="CLOSE" fieldType="LABEL" defaultValue="}" uiWidget="text" uiLabel="Body end" uiOrder="7" uiReadonly="true" uiVariant="default"/>
    <statementInputs name="STACK" checkType="PondCommand" upperBound="50" uiWidget="slot" uiLabel="Body" uiOrder="6" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="procedures_defreturn" label="function definition with return" colour="290" categoryName="Functions" connectionType="NONE" message0="%1 %2 %3%4%5%6return %7%8" inputsInline="true" tooltip="Creates a function with an output." helpUrl="https://en.wikipedia.org/wiki/Subroutine" codeTemplate="function {{NAME}}({{PARAMS}}) {&#xA;{{statements:STACK}}&#xA;return {{value:RETURN}};&#xA;}">
    <orderedInputNames>FUNCTION</orderedInputNames>
    <orderedInputNames>NAME</orderedInputNames>
    <orderedInputNames>OPEN</orderedInputNames>
    <orderedInputNames>PARAMS</orderedInputNames>
    <orderedInputNames>BODY</orderedInputNames>
    <orderedInputNames>STACK</orderedInputNames>
    <orderedInputNames>RETURN</orderedInputNames>
    <orderedInputNames>CLOSE</orderedInputNames>
    <fields name="FUNCTION" fieldType="LABEL" defaultValue="function" uiWidget="text" uiLabel="Keyword" uiOrder="1" uiReadonly="true" uiVariant="default"/>
    <fields name="NAME" defaultValue="" uiWidget="text" uiLabel="Name" uiOrder="2" uiVariant="default"/>
    <fields name="OPEN" fieldType="LABEL" defaultValue="(" uiWidget="text" uiLabel="Open parenthesis" uiOrder="3" uiReadonly="true" uiVariant="default"/>
    <fields name="PARAMS" fieldType="LABEL" defaultValue="" uiWidget="text" uiLabel="Parameters" uiOrder="4" uiReadonly="true" uiVariant="default"/>
    <fields name="BODY" fieldType="LABEL" defaultValue=") {" uiWidget="text" uiLabel="Body start" uiOrder="5" uiReadonly="true" uiVariant="default"/>
    <fields name="CLOSE" fieldType="LABEL" defaultValue="}" uiWidget="text" uiLabel="Body end" uiOrder="8" uiReadonly="true" uiVariant="default"/>
    <statementInputs name="STACK" checkType="PondCommand" upperBound="50" uiWidget="slot" uiLabel="Body" uiOrder="6" uiVariant="default"/>
    <valueInputs name="RETURN" checkType="Number" uiWidget="expression-slot" uiLabel="Return value" uiOrder="7" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="procedures_callnoreturn" label="function call" colour="290" categoryName="Functions" superTypeName="PondCommand" connectionType="TYPED" connectionTypeName="PondCommand" message0="%1%2%3" inputsInline="true" tooltip="Run the user-defined function '%1'." helpUrl="https://en.wikipedia.org/wiki/Subroutine" codeTemplate="{{NAME}}();">
    <orderedInputNames>NAME</orderedInputNames>
    <orderedInputNames>OPEN</orderedInputNames>
    <orderedInputNames>TAIL</orderedInputNames>
    <fields name="NAME" fieldType="LABEL" defaultValue="" uiWidget="text" uiLabel="Function" uiOrder="1" uiReadonly="true" uiVariant="default"/>
    <fields name="OPEN" fieldType="LABEL" defaultValue="(" uiWidget="text" uiLabel="Open parenthesis" uiOrder="2" uiReadonly="true" uiVariant="default"/>
    <fields name="TAIL" fieldType="LABEL" defaultValue=");" uiWidget="text" uiLabel="Call end" uiOrder="3" uiReadonly="true" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="procedures_callreturn" label="function call with return" colour="290" categoryName="Functions" connectionType="OUTPUT" outputType="procedures_callreturn" message0="%1%2%3" inputsInline="true" tooltip="Run the user-defined function '%1' and use its output." helpUrl="https://en.wikipedia.org/wiki/Subroutine" codeTemplate="{{NAME}}()">
    <orderedInputNames>NAME</orderedInputNames>
    <orderedInputNames>OPEN</orderedInputNames>
    <orderedInputNames>TAIL</orderedInputNames>
    <fields name="NAME" fieldType="LABEL" defaultValue="" uiWidget="text" uiLabel="Function" uiOrder="1" uiReadonly="true" uiVariant="default"/>
    <fields name="OPEN" fieldType="LABEL" defaultValue="(" uiWidget="text" uiLabel="Open parenthesis" uiOrder="2" uiReadonly="true" uiVariant="default"/>
    <fields name="TAIL" fieldType="LABEL" defaultValue=")" uiWidget="text" uiLabel="Call end" uiOrder="3" uiReadonly="true" uiVariant="default"/>
  </blockTypes>
  <validations type="CARDINALITY" name="controls_if_DO0" ownerType="controls_if" containmentName="DO0" upperBound="50">
    <visualBlock blocklyBlockType="validation_statement_cardinality">
      <fields name="TYPE" value="controls_if"/>
      <fields name="INPUT" value="DO0"/>
      <fields name="MIN" value="0"/>
      <fields name="MAX" value="50"/>
    </visualBlock>
    <visualExpression kind="LOGIC_COMPARE" operator="LTE">
      <children kind="INPUT_COUNT" fieldName="DO0"/>
      <children kind="NUMBER_LITERAL" literal="50"/>
    </visualExpression>
  </validations>
  <validations type="CARDINALITY" name="controls_whileUntil_DO" ownerType="controls_whileUntil" containmentName="DO" upperBound="50">
    <visualBlock blocklyBlockType="validation_statement_cardinality">
      <fields name="TYPE" value="controls_whileUntil"/>
      <fields name="INPUT" value="DO"/>
      <fields name="MIN" value="0"/>
      <fields name="MAX" value="50"/>
    </visualBlock>
    <visualExpression kind="LOGIC_COMPARE" operator="LTE">
      <children kind="INPUT_COUNT" fieldName="DO"/>
      <children kind="NUMBER_LITERAL" literal="50"/>
    </visualExpression>
  </validations>
  <validations type="CARDINALITY" name="procedures_defnoreturn_STACK" ownerType="procedures_defnoreturn" containmentName="STACK" upperBound="50">
    <visualBlock blocklyBlockType="validation_statement_cardinality">
      <fields name="TYPE" value="procedures_defnoreturn"/>
      <fields name="INPUT" value="STACK"/>
      <fields name="MIN" value="0"/>
      <fields name="MAX" value="50"/>
    </visualBlock>
    <visualExpression kind="LOGIC_COMPARE" operator="LTE">
      <children kind="INPUT_COUNT" fieldName="STACK"/>
      <children kind="NUMBER_LITERAL" literal="50"/>
    </visualExpression>
  </validations>
  <validations type="CARDINALITY" name="procedures_defreturn_STACK" ownerType="procedures_defreturn" containmentName="STACK" upperBound="50">
    <visualBlock blocklyBlockType="validation_statement_cardinality">
      <fields name="TYPE" value="procedures_defreturn"/>
      <fields name="INPUT" value="STACK"/>
      <fields name="MIN" value="0"/>
      <fields name="MAX" value="50"/>
    </visualBlock>
    <visualExpression kind="LOGIC_COMPARE" operator="LTE">
      <children kind="INPUT_COUNT" fieldName="STACK"/>
      <children kind="NUMBER_LITERAL" literal="50"/>
    </visualExpression>
  </validations>
  <workspaceOptions key="renderer" value="geras"/>
  <workspaceOptions key="trashcan" value="true" valueType="BOOLEAN"/>
</blocklyspec:EditorSpec>
