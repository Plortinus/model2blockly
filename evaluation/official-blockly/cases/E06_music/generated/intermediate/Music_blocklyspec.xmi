<?xml version="1.0" encoding="UTF-8"?>
<blocklyspec:EditorSpec xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:blocklyspec="http://www.example.org/model2blockly/intermediate/BlocklyEditorSpec" domainName="Music" nsURI="http://www.example.org/music" nsPrefix="music" toolboxType="category" codeLanguage="javascript" codeFileExtension="js">
  <categories name="Music" label="Music" colour="160"/>
  <blockTypes typeName="MusicCommand" label="MusicCommand" abstract="true" connectionType="TYPED" connectionTypeName="MusicCommand" inputsInline="true"/>
  <blockTypes typeName="Number" label="Number" abstract="true" connectionType="OUTPUT" outputType="Number" inputsInline="true"/>
  <blockTypes typeName="music_pitch" label="pitch" colour="230" categoryName="Music" superTypeName="Number" connectionType="OUTPUT_TYPED" outputType="Number" message0="%1" inputsInline="false" tooltip="One note (C4 is 7)." codeTemplate="{{PITCH}}">
    <orderedInputNames>PITCH</orderedInputNames>
    <fields name="PITCH" fieldType="INTEGER" defaultValue="7" min="0" max="12" uiWidget="number" uiLabel="Pitch" uiHelp="0=C3, 7=C4, 12=A4" uiOrder="1" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="music_note" label="play note" colour="160" categoryName="Music" superTypeName="MusicCommand" connectionType="TYPED" connectionTypeName="MusicCommand" message0="play %1 note %2" inputsInline="true" tooltip="Plays one musical note of the specified duration and pitch." codeTemplate="play({{DURATION}}, {{value:PITCH}});">
    <orderedInputNames>DURATION</orderedInputNames>
    <orderedInputNames>PITCH</orderedInputNames>
    <fields name="DURATION" fieldType="DROPDOWN" defaultValue="whole" uiWidget="select" uiLabel="Duration" uiOrder="1" uiVariant="default">
      <options value="whole" label="1/1"/>
      <options value="half" label="1/2"/>
      <options value="quarter" label="1/4"/>
      <options value="eighth" label="1/8"/>
      <options value="sixteenth" label="1/16"/>
    </fields>
    <valueInputs name="PITCH" checkType="Number" shadowBlockType="music_pitch" uiWidget="expression-slot" uiLabel="Pitch" uiOrder="2" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="music_rest_whole" label="whole rest" colour="160" categoryName="Music" superTypeName="MusicCommand" connectionType="TYPED" connectionTypeName="MusicCommand" message0="rest %1" inputsInline="true" tooltip="Waits for one whole note." codeTemplate="rest(1);">
    <orderedInputNames>REST_IMAGE</orderedInputNames>
    <fields name="REST_IMAGE" fieldType="IMAGE" defaultValue="" imageUrl="music/rest1.png" imageWidth="10" imageHeight="20" imageAlt="1/1" uiWidget="image" uiLabel="Whole rest" uiOrder="1" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="music_rest" label="rest" colour="160" categoryName="Music" superTypeName="MusicCommand" connectionType="TYPED" connectionTypeName="MusicCommand" message0="rest %1" inputsInline="true" tooltip="Waits for the specified duration." codeTemplate="rest({{DURATION}});">
    <orderedInputNames>DURATION</orderedInputNames>
    <fields name="DURATION" fieldType="DROPDOWN" defaultValue="whole" uiWidget="select" uiLabel="Duration" uiOrder="1" uiVariant="default">
      <options value="whole" label="1/1"/>
      <options value="half" label="1/2"/>
      <options value="quarter" label="1/4"/>
      <options value="eighth" label="1/8"/>
      <options value="sixteenth" label="1/16"/>
    </fields>
  </blockTypes>
  <blockTypes typeName="music_instrument" label="set instrument" colour="160" categoryName="Music" superTypeName="MusicCommand" connectionType="TYPED" connectionTypeName="MusicCommand" message0="set instrument to %1" inputsInline="true" tooltip="Switches to the specified instrument when playing subsequent musical notes." codeTemplate="setInstrument('{{INSTRUMENT}}');">
    <orderedInputNames>INSTRUMENT</orderedInputNames>
    <fields name="INSTRUMENT" fieldType="DROPDOWN" defaultValue="piano" uiWidget="select" uiLabel="Instrument" uiOrder="1" uiVariant="default">
      <options value="piano" label="piano"/>
      <options value="trumpet" label="trumpet"/>
      <options value="banjo" label="banjo"/>
      <options value="violin" label="violin"/>
      <options value="guitar" label="guitar"/>
      <options value="flute" label="flute"/>
      <options value="drum" label="drum"/>
      <options value="choir" label="choir"/>
    </fields>
  </blockTypes>
  <blockTypes typeName="music_start" label="when play clicked" colour="0" categoryName="Music" connectionType="NONE" message0="when %1 clicked%2" inputsInline="false" tooltip="Executes the blocks inside when the 'Run Program' button is clicked." codeTemplate="function start{{counter}}() {&#xA;{{statements:STACK}}&#xA;}">
    <orderedInputNames>PLAY_IMAGE</orderedInputNames>
    <orderedInputNames>STACK</orderedInputNames>
    <fields name="PLAY_IMAGE" fieldType="IMAGE" defaultValue="" imageUrl="music/play.png" imageWidth="17" imageHeight="17" imageAlt="▶" uiWidget="image" uiLabel="Run" uiOrder="1" uiVariant="default"/>
    <statementInputs name="STACK" checkType="MusicCommand" upperBound="50" uiWidget="slot" uiLabel="Stack" uiOrder="2" uiVariant="default"/>
  </blockTypes>
  <validations type="CARDINALITY" name="music_start_STACK" ownerType="music_start" containmentName="STACK" upperBound="50">
    <visualBlock blocklyBlockType="validation_statement_cardinality">
      <fields name="TYPE" value="music_start"/>
      <fields name="INPUT" value="STACK"/>
      <fields name="MIN" value="0"/>
      <fields name="MAX" value="50"/>
    </visualBlock>
    <visualExpression kind="LOGIC_COMPARE" operator="LTE">
      <children kind="INPUT_COUNT" fieldName="STACK"/>
      <children kind="NUMBER_LITERAL" literal="50"/>
    </visualExpression>
  </validations>
  <workspaceOptions key="renderer" value="geras"/>
  <workspaceOptions key="trashcan" value="false" valueType="BOOLEAN"/>
</blocklyspec:EditorSpec>
