<?xml version="1.0" encoding="UTF-8"?>
<blocklyspec:EditorSpec xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:blocklyspec="http://www.example.org/model2blockly/intermediate/BlocklyEditorSpec" domainName="Bird" nsURI="http://www.example.org/bird" nsPrefix="bird" toolboxType="flyout" codeLanguage="javascript" codeFileExtension="js">
  <categories name="Number" label="Number" colour="0"/>
  <categories name="Boolean" label="Boolean" colour="90"/>
  <categories name="bird_heading" label="heading" colour="180"/>
  <categories name="bird_ifElse" label="if, do, else" colour="270"/>
  <blockTypes typeName="Number" label="Number" abstract="true" connectionType="OUTPUT" outputType="Number" inputsInline="true"/>
  <blockTypes typeName="Boolean" label="Boolean" abstract="true" connectionType="OUTPUT" outputType="Boolean" inputsInline="true"/>
  <blockTypes typeName="bird_noWorm" label="does not have worm" colour="330" categoryName="Boolean" superTypeName="Boolean" connectionType="OUTPUT_TYPED" outputType="Boolean" message0="does not have worm" inputsInline="false" tooltip="The condition when the bird has not gotten the worm." codeTemplate="noWorm()"/>
  <blockTypes typeName="bird_heading" label="heading" colour="290" categoryName="bird_heading" connectionType="TYPED" connectionTypeName="bird_heading" message0="heading%1" inputsInline="false" tooltip="Move in the direction of the given angle: 0 is to the right, 90 is straight up, etc." codeTemplate="heading({{ANGLE}});">
    <orderedInputNames>ANGLE</orderedInputNames>
    <fields name="ANGLE" fieldType="ANGLE" defaultValue="90" uiWidget="angle" uiLabel="Angle" uiOrder="1" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="bird_position" label="position" colour="330" categoryName="Number" superTypeName="Number" connectionType="OUTPUT_TYPED" outputType="Number" message0="%1" inputsInline="false" tooltip="x and y mark the bird's position. When x = 0 the bird is near the left edge, when x = 100 it's near the right edge. When y = 0 the bird is at the bottom, when y = 100 it's at the top." codeTemplate="get{{XY}}()">
    <orderedInputNames>XY</orderedInputNames>
    <fields name="XY" fieldType="DROPDOWN" defaultValue="X" uiWidget="select" uiLabel="Coordinate" uiOrder="1" uiVariant="default">
      <options value="X" label="x"/>
      <options value="Y" label="y"/>
    </fields>
  </blockTypes>
  <blockTypes typeName="bird_compare" label="compare" colour="210" categoryName="Boolean" superTypeName="Boolean" connectionType="OUTPUT_TYPED" outputType="Boolean" message0="%1%2%3" inputsInline="true" tooltip="Return true if the first input is smaller than the second input." helpUrl="https://en.wikipedia.org/wiki/Inequality_(mathematics)" codeTemplate="{{value:A}} {{OP}} {{value:B}}">
    <orderedInputNames>A</orderedInputNames>
    <orderedInputNames>OP</orderedInputNames>
    <orderedInputNames>B</orderedInputNames>
    <fields name="OP" fieldType="DROPDOWN" defaultValue="LT" uiWidget="select" uiLabel="Operator" uiOrder="2" uiVariant="default">
      <options value="LT" label="‏&lt;"/>
      <options value="GT" label="‏>"/>
    </fields>
    <valueInputs name="A" checkType="Number" uiWidget="expression-slot" uiLabel="Left operand" uiOrder="1" uiVariant="default"/>
    <valueInputs name="B" checkType="Number" uiWidget="expression-slot" uiLabel="Right operand" uiOrder="3" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="bird_and" label="and" colour="210" categoryName="Boolean" superTypeName="Boolean" connectionType="OUTPUT_TYPED" outputType="Boolean" message0="%1and%2" inputsInline="true" tooltip="Return true if both inputs are true." helpUrl="https://github.com/RaspberryPiFoundation/blockly/wiki/Logic#logical-operations" codeTemplate="{{value:A}} &amp;&amp; {{value:B}}">
    <orderedInputNames>A</orderedInputNames>
    <orderedInputNames>B</orderedInputNames>
    <valueInputs name="A" checkType="Boolean" uiWidget="expression-slot" uiLabel="Left operand" uiOrder="1" uiVariant="default"/>
    <valueInputs name="B" checkType="Boolean" uiWidget="expression-slot" uiLabel="Right operand" uiOrder="2" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="bird_ifElse" label="if, do, else" colour="210" categoryName="bird_ifElse" connectionType="NONE" message0="if%1do%2else%3" inputsInline="false" tooltip="If a value is true, then do the first block of statements. Otherwise, do the second block of statements." helpUrl="https://github.com/RaspberryPiFoundation/blockly/wiki/IfElse" codeTemplate="if ({{value:CONDITION}}) {&#xA;{{statements:DO}}&#xA;} else {&#xA;{{statements:ELSE}}&#xA;}">
    <orderedInputNames>CONDITION</orderedInputNames>
    <orderedInputNames>DO</orderedInputNames>
    <orderedInputNames>ELSE</orderedInputNames>
    <statementInputs name="DO" checkType="bird_heading" upperBound="10" uiWidget="slot" uiLabel="Do" uiOrder="2" uiVariant="default"/>
    <statementInputs name="ELSE" checkType="bird_heading" upperBound="10" uiWidget="slot" uiLabel="Else" uiOrder="3" uiVariant="default"/>
    <valueInputs name="CONDITION" checkType="Boolean" uiWidget="expression-slot" uiLabel="Condition" uiOrder="1" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="math_number" label="number" colour="230" categoryName="Number" superTypeName="Number" connectionType="OUTPUT_TYPED" outputType="Number" message0="%1" inputsInline="false" tooltip="A number." helpUrl="https://en.wikipedia.org/wiki/Number" codeTemplate="{{NUM}}">
    <orderedInputNames>NUM</orderedInputNames>
    <fields name="NUM" fieldType="INTEGER" defaultValue="0" uiWidget="number" uiLabel="Number" uiOrder="1" uiVariant="default"/>
  </blockTypes>
  <validations type="CARDINALITY" name="bird_ifElse_DO" ownerType="bird_ifElse" containmentName="DO" upperBound="10">
    <visualBlock blocklyBlockType="validation_statement_cardinality">
      <fields name="TYPE" value="bird_ifElse"/>
      <fields name="INPUT" value="DO"/>
      <fields name="MIN" value="0"/>
      <fields name="MAX" value="10"/>
    </visualBlock>
    <visualExpression kind="LOGIC_COMPARE" operator="LTE">
      <children kind="INPUT_COUNT" fieldName="DO"/>
      <children kind="NUMBER_LITERAL" literal="10"/>
    </visualExpression>
  </validations>
  <validations type="CARDINALITY" name="bird_ifElse_ELSE" ownerType="bird_ifElse" containmentName="ELSE" upperBound="10">
    <visualBlock blocklyBlockType="validation_statement_cardinality">
      <fields name="TYPE" value="bird_ifElse"/>
      <fields name="INPUT" value="ELSE"/>
      <fields name="MIN" value="0"/>
      <fields name="MAX" value="10"/>
    </visualBlock>
    <visualExpression kind="LOGIC_COMPARE" operator="LTE">
      <children kind="INPUT_COUNT" fieldName="ELSE"/>
      <children kind="NUMBER_LITERAL" literal="10"/>
    </visualExpression>
  </validations>
  <workspaceOptions key="renderer" value="geras"/>
  <workspaceOptions key="trashcan" value="false" valueType="BOOLEAN"/>
</blocklyspec:EditorSpec>
