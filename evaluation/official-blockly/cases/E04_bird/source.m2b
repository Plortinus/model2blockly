domain Bird
codeLanguage "javascript"
codeFileExtension "js"

workspace {
  renderer: "geras"
  toolboxType: "flyout"
  trashcan: false
}

abstract output class Number {
}

abstract output class Boolean {
}

output as Boolean class bird_noWorm extends Boolean colour 330
  label "does not have worm"
  message0 "does not have worm"
  tooltip "The condition when the bird has not gotten the worm."
  inputsInline false
  code "noWorm()" {
}

class bird_heading colour 290
  label "heading"
  message0 "heading%1"
  tooltip "Move in the direction of the given angle: 0 is to the right, 90 is straight up, etc."
  inputsInline false
  code "heading({{ANGLE}});" {
  attribute ANGLE : angle [0..1] default "90"
    widget angle uiLabel "Angle" order 1 variant default
}

output as Number class bird_position extends Number colour 330
  label "position"
  message0 "%1"
  tooltip "x and y mark the bird's position. When x = 0 the bird is near the left edge, when x = 100 it's near the right edge. When y = 0 the bird is at the bottom, when y = 100 it's at the top."
  inputsInline false
  code "get{{XY}}()" {
  attribute XY : enum {
    X = "x",
    Y = "y"
  } [0..1] default "X"
    widget select uiLabel "Coordinate" order 1 variant default
}

output as Boolean class bird_compare extends Boolean colour 210
  label "compare"
  message0 "%1%2%3"
  tooltip "Return true if the first input is smaller than the second input."
  helpUrl "https://en.wikipedia.org/wiki/Inequality_(mathematics)"
  inputsInline true
  code "{{value:A}} {{OP}} {{value:B}}" {
  value Number A
    widget expression-slot uiLabel "Left operand" order 1 variant default
  attribute OP : enum {
    LT = "‏<",
    GT = "‏>"
  } [0..1] default "LT"
    widget select uiLabel "Operator" order 2 variant default
  value Number B
    widget expression-slot uiLabel "Right operand" order 3 variant default
}

output as Boolean class bird_and extends Boolean colour 210
  label "and"
  message0 "%1and%2"
  tooltip "Return true if both inputs are true."
  helpUrl "https://github.com/RaspberryPiFoundation/blockly/wiki/Logic#logical-operations"
  inputsInline true
  code "{{value:A}} && {{value:B}}" {
  value Boolean A
    widget expression-slot uiLabel "Left operand" order 1 variant default
  value Boolean B
    widget expression-slot uiLabel "Right operand" order 2 variant default
}

class bird_ifElse colour 210
  label "if, do, else"
  message0 "if%1do%2else%3"
  tooltip "If a value is true, then do the first block of statements. Otherwise, do the second block of statements."
  helpUrl "https://github.com/RaspberryPiFoundation/blockly/wiki/IfElse"
  inputsInline false
  code "if ({{value:CONDITION}}) {\n{{statements:DO}}\n} else {\n{{statements:ELSE}}\n}" {
  value Boolean CONDITION
    widget expression-slot uiLabel "Condition" order 1 variant default
  contains bird_heading DO [0..10]
    widget slot uiLabel "Do" order 2 variant default
  contains bird_heading ELSE [0..10]
    widget slot uiLabel "Else" order 3 variant default
}

output as Number class math_number extends Number colour 230
  label "number"
  message0 "%1"
  tooltip "A number."
  helpUrl "https://en.wikipedia.org/wiki/Number"
  inputsInline false
  code "{{NUM}}" {
  attribute NUM : int [0..1] default "0"
    widget number uiLabel "Number" order 1 variant default
}
