<?xml version="1.0" encoding="UTF-8"?>
<blocklyspec:EditorSpec xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:blocklyspec="http://www.example.org/model2blockly/intermediate/BlocklyEditorSpec" domainName="EcoreSpecific" nsURI="http://www.example.org/ecorespecific" nsPrefix="ecorespecific" codeLanguage="text" codeFileExtension="txt">
  <categories name="Catalog" label="Catalog"/>
  <categories name="Elements" label="Elements" colour="160"/>
  <blockTypes typeName="Catalog" label="Catalog" categoryName="Catalog" connectionType="NONE" inputsInline="false">
    <orderedInputNames>name</orderedInputNames>
    <orderedInputNames>entries</orderedInputNames>
    <orderedInputNames>featured</orderedInputNames>
    <fields name="name" defaultValue="Technical catalog"/>
    <statementInputs name="entries" checkType="NamedElement" lowerBound="1" upperBound="4"/>
    <referenceFields name="featured" targetTypeName="Entry" referenceLabelField="entryId"/>
  </blockTypes>
  <blockTypes typeName="NamedElement" label="NamedElement" colour="160" categoryName="Elements" abstract="true" connectionType="TYPED" connectionTypeName="NamedElement" inputsInline="false">
    <orderedInputNames>title</orderedInputNames>
    <fields name="title" defaultValue="Named element" required="true" lowerBound="1"/>
  </blockTypes>
  <blockTypes typeName="Entry" label="Entry" colour="160" categoryName="Elements" superTypeName="NamedElement" connectionType="TYPED" connectionTypeName="NamedElement" inputsInline="false" idFieldName="entryId">
    <orderedInputNames>title</orderedInputNames>
    <orderedInputNames>entryId</orderedInputNames>
    <orderedInputNames>longCount</orderedInputNames>
    <orderedInputNames>shortCount</orderedInputNames>
    <orderedInputNames>bigCount</orderedInputNames>
    <orderedInputNames>doubleRatio</orderedInputNames>
    <orderedInputNames>decimalRatio</orderedInputNames>
    <fields name="title" defaultValue="Named element" required="true" lowerBound="1"/>
    <fields name="entryId" defaultValue="entry-1" required="true" lowerBound="1" id="true"/>
    <fields name="longCount" fieldType="INTEGER" defaultValue="1000"/>
    <fields name="shortCount" fieldType="INTEGER" defaultValue="12"/>
    <fields name="bigCount" fieldType="INTEGER" defaultValue="123456789"/>
    <fields name="doubleRatio" fieldType="FLOAT" defaultValue="0.5"/>
    <fields name="decimalRatio" fieldType="FLOAT" defaultValue="0.75"/>
  </blockTypes>
  <validations type="EXPRESSION" name="Entry_HasTitle" ownerType="Entry" expression="has(&quot;title&quot;)" message="Constraint &quot;HasTitle&quot; is violated on Entry.">
    <visualBlock blocklyBlockType="validation_expression_rule">
      <fields name="TYPE" value="Entry"/>
      <fields name="EXPRESSION" value="has(&quot;title&quot;)"/>
      <inputs name="CONDITION">
        <expression kind="FIELD_EXISTS" fieldName="title"/>
      </inputs>
    </visualBlock>
    <visualExpression kind="FIELD_EXISTS" fieldName="title"/>
  </validations>
  <validations type="CARDINALITY" name="Catalog_entries" ownerType="Catalog" containmentName="entries" lowerBound="1" upperBound="4">
    <visualBlock blocklyBlockType="validation_statement_cardinality">
      <fields name="TYPE" value="Catalog"/>
      <fields name="INPUT" value="entries"/>
      <fields name="MIN" value="1"/>
      <fields name="MAX" value="4"/>
    </visualBlock>
    <visualExpression operator="AND">
      <children kind="LOGIC_COMPARE" operator="GTE">
        <children kind="INPUT_COUNT" fieldName="entries"/>
        <children kind="NUMBER_LITERAL" literal="1"/>
      </children>
      <children kind="LOGIC_COMPARE" operator="LTE">
        <children kind="INPUT_COUNT" fieldName="entries"/>
        <children kind="NUMBER_LITERAL" literal="4"/>
      </children>
    </visualExpression>
  </validations>
  <validations type="REQUIRED" name="Entry_title_required" ownerType="Entry" fieldName="title" fieldKind="attribute">
    <visualBlock blocklyBlockType="validation_required_field">
      <fields name="TYPE" value="Entry"/>
      <fields name="FIELD" value="title"/>
      <fields name="FIELD_KIND" value="attribute"/>
    </visualBlock>
    <visualExpression kind="FIELD_EXISTS" fieldName="title"/>
  </validations>
  <validations type="REQUIRED" name="Entry_entryId_required" ownerType="Entry" fieldName="entryId" fieldKind="attribute">
    <visualBlock blocklyBlockType="validation_required_field">
      <fields name="TYPE" value="Entry"/>
      <fields name="FIELD" value="entryId"/>
      <fields name="FIELD_KIND" value="attribute"/>
    </visualBlock>
    <visualExpression kind="FIELD_EXISTS" fieldName="entryId"/>
  </validations>
  <validations type="UNIQUE" name="Entry_entryId_unique" ownerType="Entry" fieldName="entryId" fieldKind="id">
    <visualBlock blocklyBlockType="validation_type_field_unique">
      <fields name="TYPE" value="Entry"/>
      <fields name="FIELD" value="entryId"/>
    </visualBlock>
    <visualExpression kind="TYPE_FIELD_UNIQUE" fieldName="entryId" typeName="Entry"/>
  </validations>
</blocklyspec:EditorSpec>
