<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="compositionInputs"
    nsURI="http://www.example.org/compositioninputs"
    nsPrefix="compositioninputs">

  <eClassifiers xsi:type="ecore:EClass" name="Document">
    <eAnnotations source="blockly">
      <details key="colour" value="200"/>
      <details key="category" value="Composition"/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="Release notes">
      <eAnnotations source="ui">
        <details key="widget" value="text"/>
        <details key="label" value="Title"/>
        <details key="order" value="1"/>
        <details key="variant" value="default"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sections"
        lowerBound="1" upperBound="4" eType="#//Section" containment="true">
      <eAnnotations source="ui">
        <details key="widget" value="slot"/>
        <details key="label" value="Sections"/>
        <details key="order" value="2"/>
        <details key="variant" value="default"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Section" abstract="true">
    <eAnnotations source="blockly">
      <details key="colour" value="120"/>
      <details key="category" value="Composition"/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Paragraph" eSuperTypes="#//Section">
    <eAnnotations source="blockly">
      <details key="colour" value="120"/>
      <details key="category" value="Composition"/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="heading"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="Summary">
      <eAnnotations source="ui">
        <details key="widget" value="text"/>
        <details key="label" value="Heading"/>
        <details key="order" value="1"/>
        <details key="variant" value="default"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="content"
        eType="#//TextExpression" containment="true">
      <eAnnotations source="blockly">
        <details key="type" value="input_value"/>
        <details key="check" value="TextExpression"/>
        <details key="shadow" value="TextLiteral"/>
      </eAnnotations>
      <eAnnotations source="ui">
        <details key="widget" value="expression-slot"/>
        <details key="label" value="Content"/>
        <details key="order" value="2"/>
        <details key="variant" value="default"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="emphasis"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="false">
      <eAnnotations source="ui">
        <details key="widget" value="checkbox"/>
        <details key="label" value="Emphasis"/>
        <details key="order" value="3"/>
        <details key="variant" value="default"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="TextExpression" abstract="true">
    <eAnnotations source="blockly">
      <details key="colour" value="230"/>
      <details key="category" value="Expressions"/>
      <details key="output" value="true"/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="TextLiteral"
      eSuperTypes="#//TextExpression">
    <eAnnotations source="blockly">
      <details key="colour" value="230"/>
      <details key="category" value="Expressions"/>
      <details key="output" value="TextExpression"/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="textValue"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="Ready">
      <eAnnotations source="ui">
        <details key="widget" value="text"/>
        <details key="label" value="Text"/>
        <details key="order" value="1"/>
        <details key="variant" value="default"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

</ecore:EPackage>
