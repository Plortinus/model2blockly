domain FieldsUi

category UI colour 180 {
  category Content colour 180
  category Appearance colour 45
}

class ContentForm category Content colour 180 label "Content form"
  tooltip "Content and control field examples." inputsInline false {
  attribute title : string [1..1] default "Welcome"
    widget text uiLabel "Title" help "Heading shown to the user."
    placeholder "Enter a heading" group "Content" order 1 variant prominent
  attribute description : string [0..1] default "Short description"
    widget textarea uiLabel "Description" group "Content" order 2 variant default
  attribute quantity : int [0..1] default "3" min "0" max "10"
    widget number uiLabel "Quantity" group "Controls" order 3 readonly variant default
  attribute opacity : float [0..1] default "0.75" min "0" max "1"
    widget slider uiLabel "Opacity" group "Appearance" order 4 variant compact
  attribute enabled : boolean [0..1] default "true"
    widget switch uiLabel "Enabled" group "Controls" order 5 variant default
  attribute confirmed : boolean [0..1] default "false"
    widget checkbox uiLabel "Confirmed" group "Controls" order 6 variant default
  attribute mode : enum { simple, advanced } [0..1] default "simple"
    widget select uiLabel "Mode" group "Controls" order 7 variant default
  attribute alignment : enum { left, center, right } [0..1] default "left"
    widget radio uiLabel "Alignment" group "Appearance" order 8 variant default
  attribute tags : string [1..3] default "new,featured"
    widget text uiLabel "Tags" help "Comma-separated labels."
    group "Content" order 9 variant compact
  attribute internalCode : string [0..1] default "FORM-01"
    widget text uiLabel "Internal code" group "System" order 10 hidden variant default
}

class VisualFields category Appearance colour 45 label "Visual fields"
  message0 "visual fields colour %1 angle %2 image %3 label %4"
  tooltip "Direct colour, angle, image, and label field mappings."
  helpUrl "https://developers.google.com/blockly" inputsInline false {
  attribute colourValue : colour [0..1] default "#1f6feb"
  attribute angleValue : angle [0..1] default "45"
  attribute imageValue : image [0..1]
    src "https://developers.google.com/blockly/images/logos/logo_built_on.svg"
    width 32 height 32 alt "Blockly"
  attribute labelValue : label [0..1] default "Label"
}
