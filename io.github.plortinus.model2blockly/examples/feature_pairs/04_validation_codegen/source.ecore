<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="validationCodegen"
    nsURI="http://www.example.org/validationcodegen"
    nsPrefix="validationcodegen">

  <eAnnotations source="blockly">
    <details key="workspace.renderer" value="zelos"/>
    <details key="workspace.trashcan" value="true"/>
    <details key="workspace.toolboxType" value="flyout"/>
    <details key="workspace.grid.spacing" value="24"/>
    <details key="workspace.grid.snap" value="true"/>
    <details key="workspace.zoom.controls" value="true"/>
    <details key="workspace.zoom.startScale" value="1"/>
    <details key="workspace.zoom.maxScale" value="3"/>
  </eAnnotations>
  <eAnnotations source="code">
    <details key="language" value="javascript"/>
    <details key="fileExtension" value="js"/>
  </eAnnotations>
  <eAnnotations source="runtime">
    <details key="kind" value="workflow"/>
  </eAnnotations>

  <eClassifiers xsi:type="ecore:EClass" name="Page">
    <eAnnotations source="blockly">
      <details key="colour" value="260"/>
      <details key="category" value="Pages"/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
    <eAnnotations source="validation">
      <details key="expression.routeStartsSlash" value="value('route').startsWith('/')"/>
      <details key="message.routeStartsSlash" value="Route must start with /."/>
      <details key="condition.titlePresent" value="has('title')"/>
      <details key="message.titlePresent" value="Page title is required."/>
      <details key="js.actionsWithinLimit" value="size('actions') &lt;= 4"/>
      <details key="message.actionsWithinLimit" value="A page supports at most four actions."/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="HasActions"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="HasActions" value="self.actions-&gt;size() &gt;= 1"/>
    </eAnnotations>
    <eAnnotations source="code">
      <details key="template" value="page({{title}}, [{{statements:actions}}]);"/>
    </eAnnotations>

    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pageId"
        iD="true" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="page-1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="Home"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="route"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="/home"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="actions"
        lowerBound="1" upperBound="4" eType="#//Action" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Action" abstract="true">
    <eAnnotations source="blockly">
      <details key="colour" value="30"/>
      <details key="category" value="Actions"/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Alert" eSuperTypes="#//Action">
    <eAnnotations source="blockly">
      <details key="colour" value="30"/>
      <details key="category" value="Actions"/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
    <eAnnotations source="code">
      <details key="template" value="alert({{message}});"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="message"
        lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="Saved"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Navigate" eSuperTypes="#//Action">
    <eAnnotations source="blockly">
      <details key="colour" value="30"/>
      <details key="category" value="Actions"/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
    <eAnnotations source="validation">
      <details key="mustFollow" value="Alert"/>
    </eAnnotations>
    <eAnnotations source="code">
      <details key="template" value="navigate({{target}});"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target"
        lowerBound="1" eType="#//Page">
      <eAnnotations source="ui">
        <details key="widget" value="reference-select"/>
        <details key="label" value="Target page"/>
        <details key="order" value="1"/>
        <details key="variant" value="default"/>
        <details key="referenceLabelField" value="title"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="BooleanLiteral">
    <eAnnotations source="blockly">
      <details key="colour" value="230"/>
      <details key="category" value="Expressions"/>
      <details key="output" value="true"/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
    <eAnnotations source="code">
      <details key="template" value="{{literal}}"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="literal"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true"/>
  </eClassifiers>

</ecore:EPackage>
