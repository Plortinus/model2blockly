domain ValidationCodegen
codeLanguage "javascript"
codeFileExtension "js"
runtimeKind "workflow"

workspace {
  zoom: {
    controls: true
    maxScale: 3
    startScale: 1
  }
  renderer: "zelos"
  trashcan: true
  toolboxType: "flyout"
  grid: {
    snap: true
    spacing: 24
  }
}

category Pages colour 260
category Actions colour 30
category Expressions colour 230

class Page category Pages colour 260 inputsInline false
  code "page({{title}}, [{{statements:actions}}]);" {
  attribute pageId : string [1..1] default "page-1" modelId
  attribute title : string [1..1] default "Home"
  attribute route : string [1..1] default "/home"
  contains Action actions [1..4]
}

abstract class Action category Actions colour 30 inputsInline false {
}

class Alert extends Action category Actions colour 30 inputsInline false
  code "alert({{message}});" {
  attribute message : string [1..1] default "Saved"
}

class Navigate extends Action category Actions colour 30 inputsInline false
  code "navigate({{target}});" {
  reference Page target [1..1] required unique ordered
    widget reference-select uiLabel "Target page" order 1 variant default
    referenceLabelField title
}

output class BooleanLiteral category Expressions colour 230 inputsInline false
  code "{{literal}}" {
  attribute literal : boolean [0..1] default "true"
}

constraint Navigate_after_Alert on Navigate : must follow Alert

validation titlePresent on Page : condition "has('title')"
  errorMessage "Page title is required."
validation routeStartsSlash on Page : expression "value('route').startsWith('/')"
  errorMessage "Route must start with /."
validation actionsWithinLimit on Page : js "size('actions') <= 4"
  errorMessage "A page supports at most four actions."
validation HasActions on Page : ocl "self.actions->size() >= 1"
