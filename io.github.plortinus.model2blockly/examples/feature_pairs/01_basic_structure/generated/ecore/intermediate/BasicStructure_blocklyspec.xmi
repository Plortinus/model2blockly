<?xml version="1.0" encoding="UTF-8"?>
<blocklyspec:EditorSpec xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:blocklyspec="http://www.example.org/model2blockly/intermediate/BlocklyEditorSpec" domainName="BasicStructure" nsURI="http://www.example.org/basicstructure" nsPrefix="basicstructure" codeLanguage="text" codeFileExtension="txt">
  <categories name="Board" label="Board" colour="0"/>
  <categories name="WorkItem" label="WorkItem" colour="120"/>
  <categories name="Tag" label="Tag" colour="240"/>
  <blockTypes typeName="Board" label="Board" categoryName="Board" connectionType="NONE" inputsInline="false">
    <orderedInputNames>name</orderedInputNames>
    <orderedInputNames>items</orderedInputNames>
    <fields name="name" defaultValue="Sprint board"/>
    <statementInputs name="items" checkType="WorkItem" lowerBound="1" upperBound="4"/>
  </blockTypes>
  <blockTypes typeName="WorkItem" label="WorkItem" abstract="true" connectionType="TYPED" connectionTypeName="WorkItem" inputsInline="false"/>
  <blockTypes typeName="Task" label="Task" categoryName="WorkItem" superTypeName="WorkItem" connectionType="TYPED" connectionTypeName="WorkItem" inputsInline="false">
    <orderedInputNames>title</orderedInputNames>
    <orderedInputNames>priority</orderedInputNames>
    <orderedInputNames>done</orderedInputNames>
    <fields name="title" defaultValue="Write docs"/>
    <fields name="priority" fieldType="DROPDOWN" defaultValue="medium">
      <options value="low" label="low"/>
      <options value="medium" label="medium"/>
      <options value="high" label="high"/>
    </fields>
    <fields name="done" fieldType="BOOLEAN" defaultValue="false"/>
  </blockTypes>
  <blockTypes typeName="Note" label="Note" categoryName="WorkItem" superTypeName="WorkItem" connectionType="TYPED" connectionTypeName="WorkItem" inputsInline="false">
    <orderedInputNames>body</orderedInputNames>
    <fields name="body" defaultValue="Remember the review"/>
  </blockTypes>
  <blockTypes typeName="Tag" label="Tag" categoryName="Tag" inputsInline="false">
    <orderedInputNames>name</orderedInputNames>
    <fields name="name" defaultValue="important"/>
  </blockTypes>
  <validations type="CARDINALITY" name="Board_items" ownerType="Board" containmentName="items" lowerBound="1" upperBound="4">
    <visualBlock blocklyBlockType="validation_statement_cardinality">
      <fields name="TYPE" value="Board"/>
      <fields name="INPUT" value="items"/>
      <fields name="MIN" value="1"/>
      <fields name="MAX" value="4"/>
    </visualBlock>
    <visualExpression operator="AND">
      <children kind="LOGIC_COMPARE" operator="GTE">
        <children kind="INPUT_COUNT" fieldName="items"/>
        <children kind="NUMBER_LITERAL" literal="1"/>
      </children>
      <children kind="LOGIC_COMPARE" operator="LTE">
        <children kind="INPUT_COUNT" fieldName="items"/>
        <children kind="NUMBER_LITERAL" literal="4"/>
      </children>
    </visualExpression>
  </validations>
</blocklyspec:EditorSpec>
