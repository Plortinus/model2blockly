<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="interactiveApp"
    nsURI="http://www.example.org/interactiveapp"
    nsPrefix="interactiveapp">

  <eClassifiers xsi:type="ecore:EClass" name="App">
    <eAnnotations source="blockly">
      <details key="colour" value="210"/>
      <details key="category" value="Application"/>
      <details key="label" value="Application"/>
      <details key="tooltip" value="Configure the application and add its pages."/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="Welcome App"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="theme"
        eType="#//Theme" defaultValueLiteral="light"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="published"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tags" upperBound="3"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="blockly">
        <details key="initialValues" value="demo,welcome"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="previewWidths"
        lowerBound="1" upperBound="4"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
      <eAnnotations source="blockly">
        <details key="initialValues" value="360,768,1440"/>
        <details key="min" value="320"/>
        <details key="max" value="1920"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="targetPlatforms"
        lowerBound="1" upperBound="3" eType="#//Platform">
      <eAnnotations source="blockly">
        <details key="initialValues" value="web,android"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="pages"
        lowerBound="1" upperBound="5" eType="#//Page" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Page">
    <eAnnotations source="blockly">
      <details key="colour" value="160"/>
      <details key="category" value="Pages"/>
      <details key="label" value="Page"/>
      <details key="tooltip" value="Configure one page and the components shown on it."/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1"
        iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="home"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="Home"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="Main page"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="backgroundColor"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="#ffffff">
      <eAnnotations source="blockly">
        <details key="type" value="field_colour"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="scrollable"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="alignment"
        eType="#//Alignment" defaultValueLiteral="center"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="components"
        upperBound="10" eType="#//Component" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Component" abstract="true">
    <eAnnotations source="blockly">
      <details key="inputsInline" value="false"/>
    </eAnnotations>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Container" eSuperTypes="#//Component">
    <eAnnotations source="blockly">
      <details key="colour" value="290"/>
      <details key="category" value="Components"/>
      <details key="label" value="Container"/>
      <details key="tooltip" value="Group components in a nested layout."/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="layout"
        eType="#//Layout" defaultValueLiteral="column"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="children"
        lowerBound="1" upperBound="10" eType="#//Component" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Label" eSuperTypes="#//Component">
    <eAnnotations source="blockly">
      <details key="colour" value="290"/>
      <details key="category" value="Components"/>
      <details key="label" value="Label"/>
      <details key="tooltip" value="Display text on a page."/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="text" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="Welcome"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fontSize"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="24">
      <eAnnotations source="blockly">
        <details key="min" value="8"/>
        <details key="max" value="72"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="textColor"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="#202124">
      <eAnnotations source="blockly">
        <details key="type" value="field_colour"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Button" eSuperTypes="#//Component">
    <eAnnotations source="blockly">
      <details key="colour" value="20"/>
      <details key="category" value="Components"/>
      <details key="label" value="Button"/>
      <details key="tooltip" value="Associate a button with an ordered action model."/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="text" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="Continue"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="width"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="160">
      <eAnnotations source="blockly">
        <details key="min" value="60"/>
        <details key="max" value="320"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="enabled"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="backgroundColor"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="#1a73e8">
      <eAnnotations source="blockly">
        <details key="type" value="field_colour"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="onClick"
        upperBound="10" eType="#//Action" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Image" eSuperTypes="#//Component">
    <eAnnotations source="blockly">
      <details key="colour" value="65"/>
      <details key="category" value="Components"/>
      <details key="label" value="Image"/>
      <details key="tooltip" value="Display an image from a URL."/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="url" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="https://example.org/welcome.png"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rotation"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="0">
      <eAnnotations source="blockly">
        <details key="type" value="field_angle"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="opacity"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"
        defaultValueLiteral="1">
      <eAnnotations source="blockly">
        <details key="min" value="0"/>
        <details key="max" value="1"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Action" abstract="true">
    <eAnnotations source="blockly">
      <details key="inputsInline" value="false"/>
    </eAnnotations>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="NavigateAction"
      eSuperTypes="#//Action">
    <eAnnotations source="blockly">
      <details key="colour" value="20"/>
      <details key="category" value="Actions"/>
      <details key="label" value="Navigate"/>
      <details key="tooltip" value="Open an existing page in the application."/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1"
        eType="#//Page"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ShowMessageAction"
      eSuperTypes="#//Action">
    <eAnnotations source="blockly">
      <details key="colour" value="20"/>
      <details key="category" value="Actions"/>
      <details key="label" value="Show message"/>
      <details key="tooltip" value="Display text to the user."/>
      <details key="inputsInline" value="false"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="message" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="Message"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="Theme">
    <eLiterals name="light" literal="light"/>
    <eLiterals name="dark" value="1" literal="dark"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Alignment">
    <eLiterals name="left" literal="left"/>
    <eLiterals name="center" value="1" literal="center"/>
    <eLiterals name="right" value="2" literal="right"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="Layout">
    <eLiterals name="column" value="0"/>
    <eLiterals name="row" value="1"/>
    <eLiterals name="grid" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Platform">
    <eLiterals name="web" literal="web"/>
    <eLiterals name="android" value="1" literal="android"/>
    <eLiterals name="ios" value="2" literal="ios"/>
  </eClassifiers>
</ecore:EPackage>
