    { "type": "validation_field_count", "label": "Domain accessor: multi-valued field/reference count", "generator": { "format": "model2blockly.validationGenerator.v1", "runtimeCheck": "expressionNode", "expressionTemplate": "fieldCount(\"${FIELD}\")" } },
