      "name": "App_pages",
      "validationType": "CARDINALITY",
      "targetType": "App",
      "message": "App.pages has invalid cardinality.",
      "blockTree": {
        "type": "validation_rule",
        "fields": {
          "NAME": "App_pages",
          "TARGET": "App",
          "VALIDATION_TYPE": "CARDINALITY",
          "MESSAGE": "App.pages has invalid cardinality."
        },
        "inputs": {
          "CONDITION": {
            "type": "validation_statement_cardinality",
            "fields": {
              "TYPE": "App",
              "INPUT": "pages",
              "MIN": "1",
              "MAX": "5"
            }
          }
        }
      },
      "expandedExpression": {
        "type": "logic_operation",
        "fields": { "OP": "AND" },
        "inputs": {
          "A": {
            "type": "logic_compare",
            "fields": { "OP": "GTE" },
            "inputs": {
              "A": {
                "type": "validation_input_count",
                "fields": { "INPUT": "pages" }
              },
              "B": {
                "type": "math_number",
                "fields": { "NUM": "1" }
              }
            }
          },
          "B": {
            "type": "logic_compare",
            "fields": { "OP": "LTE" },
            "inputs": {
              "A": {
                "type": "validation_input_count",
                "fields": { "INPUT": "pages" }
              },
              "B": {
                "type": "math_number",
                "fields": { "NUM": "5" }
              }
            }
          }
        }
      },
      "generator": {
        "format": "model2blockly.validationGenerator.v1",
        "source": "visualBlock",
        "blockType": "validation_statement_cardinality",
        "runtimeCheck": "statementCardinality",
        "runtimeExpression": "inputCount(\"pages\") >= 1 && inputCount(\"pages\") <= 5",
        "parameters": {
