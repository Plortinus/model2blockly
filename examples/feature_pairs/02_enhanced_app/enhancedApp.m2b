domain InteractiveApp

category Application colour 210
category Pages colour 160
category Components colour 290
category Actions colour 20

class App category Application colour 210 label "Application"
  tooltip "Configure the application and add its pages." inputsInline false {
  attribute name : string [1..1] default "Welcome App"
  attribute theme : enum { light, dark } [0..1] default "light"
  attribute published : boolean [0..1] default "false"
  attribute tags : string [0..3] default "demo,welcome"
  attribute previewWidths : int [1..4] default "360,768,1440"
    min "320" max "1920"
  attribute targetPlatforms : enum { web, android, ios } [1..3]
    default "web,android"
  contains Page pages [1..5]
}

class Page category Pages colour 160 label "Page"
  tooltip "Configure one page and the components shown on it."
  inputsInline false {
  attribute id : string [1..1] default "home" modelId
  attribute title : string [1..1] default "Home"
  attribute description : string [0..1] default "Main page"
  attribute backgroundColor : colour [0..1] default "#ffffff"
  attribute scrollable : boolean [0..1] default "true"
  attribute alignment : enum { left, center, right } [0..1] default "center"
  contains Component components [0..10]
}

abstract class Component inputsInline false {
}

class Container extends Component category Components colour 290 label "Container"
  tooltip "Group components in a nested layout." inputsInline false {
  attribute layout : enum { column, row, grid } [0..1] default "column"
  contains Component children [1..10]
}

class Label extends Component category Components colour 290 label "Label"
  tooltip "Display text on a page." inputsInline false {
  attribute ^text : string [1..1] default "Welcome"
  attribute fontSize : int [0..1] default "24" min "8" max "72"
  attribute textColor : colour [0..1] default "#202124"
}

class Button extends Component category Components colour 20 label "Button"
  tooltip "Associate a button with an ordered action model."
  inputsInline false {
  attribute ^text : string [1..1] default "Continue"
  attribute ^width : int [0..1] default "160" min "60" max "320"
  attribute enabled : boolean [0..1] default "true"
  attribute backgroundColor : colour [0..1] default "#1a73e8"

  // onClick 保存一个有序的动作模型列表。
  contains Action onClick [0..10]
}

class Image extends Component category Components colour 65 label "Image"
  tooltip "Display an image from a URL." inputsInline false {
  attribute url : string [1..1]
    default "https://example.org/welcome.png"
  attribute rotation : angle [0..1] default "0"
  attribute opacity : float [0..1] default "1" min "0" max "1"
}

// Action 是抽象类型，不直接出现在工具箱中。
// 其子类生成能够上下连接的 Action 语句块。
abstract class Action inputsInline false {
}

class NavigateAction extends Action category Actions colour 20
  label "Navigate" tooltip "Open an existing page in the application."
  inputsInline false {
  reference Page target [1..1] required
}

class ShowMessageAction extends Action category Actions colour 20
  label "Show message" tooltip "Display text to the user."
  inputsInline false {
  attribute message : string [1..1] default "Message"
}
