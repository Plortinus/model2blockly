<?xml version="1.0" encoding="UTF-8"?>
<blocklyspec:EditorSpec xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:blocklyspec="http://www.example.org/model2blockly/intermediate/BlocklyEditorSpec" domainName="CodegenWorkspace" nsURI="http://www.example.org/codegenworkspace" nsPrefix="codegenworkspace" toolboxType="flyout" codeLanguage="javascript" codeFileExtension="js" runtimeKind="workflow">
  <categories name="Programs" label="Programs" colour="260"/>
  <categories name="Commands" label="Commands" colour="30"/>
  <categories name="Expressions" label="Expressions" colour="230"/>
  <blockTypes typeName="Program" label="Program" colour="260" categoryName="Programs" connectionType="NONE" inputsInline="false" codeTemplate="program('{{name}}', () => { {{statements:steps}} });">
    <orderedInputNames>name</orderedInputNames>
    <orderedInputNames>steps</orderedInputNames>
    <fields name="name" defaultValue="Demo" required="true" lowerBound="1"/>
    <statementInputs name="steps" checkType="Command" lowerBound="1" upperBound="4"/>
  </blockTypes>
  <blockTypes typeName="Command" label="Command" colour="30" categoryName="Commands" abstract="true" connectionType="TYPED" connectionTypeName="Command" inputsInline="false"/>
  <blockTypes typeName="Log" label="Log" colour="30" categoryName="Commands" superTypeName="Command" connectionType="TYPED" connectionTypeName="Command" inputsInline="false" codeTemplate="console.log('{{message}}');">
    <orderedInputNames>message</orderedInputNames>
    <fields name="message" defaultValue="Ready" required="true" lowerBound="1"/>
  </blockTypes>
  <blockTypes typeName="Wait" label="Wait" colour="30" categoryName="Commands" superTypeName="Command" connectionType="TYPED" connectionTypeName="Command" inputsInline="false" codeTemplate="wait({{milliseconds}});">
    <orderedInputNames>milliseconds</orderedInputNames>
    <fields name="milliseconds" fieldType="INTEGER" defaultValue="250" required="true" lowerBound="1"/>
  </blockTypes>
  <blockTypes typeName="BooleanLiteral" label="BooleanLiteral" colour="230" categoryName="Expressions" connectionType="OUTPUT" outputType="BooleanLiteral" inputsInline="false" codeTemplate="{{literal}}">
    <orderedInputNames>literal</orderedInputNames>
    <fields name="literal" fieldType="BOOLEAN" defaultValue="true"/>
  </blockTypes>
  <validations type="CARDINALITY" name="Program_steps" ownerType="Program" containmentName="steps" lowerBound="1" upperBound="4">
    <visualBlock blocklyBlockType="validation_statement_cardinality">
      <fields name="TYPE" value="Program"/>
      <fields name="INPUT" value="steps"/>
      <fields name="MIN" value="1"/>
      <fields name="MAX" value="4"/>
    </visualBlock>
    <visualExpression operator="AND">
      <children kind="LOGIC_COMPARE" operator="GTE">
        <children kind="INPUT_COUNT" fieldName="steps"/>
        <children kind="NUMBER_LITERAL" literal="1"/>
      </children>
      <children kind="LOGIC_COMPARE" operator="LTE">
        <children kind="INPUT_COUNT" fieldName="steps"/>
        <children kind="NUMBER_LITERAL" literal="4"/>
      </children>
    </visualExpression>
  </validations>
  <validations type="REQUIRED" name="Program_name_required" ownerType="Program" fieldName="name" fieldKind="attribute">
    <visualBlock blocklyBlockType="validation_required_field">
      <fields name="TYPE" value="Program"/>
      <fields name="FIELD" value="name"/>
      <fields name="FIELD_KIND" value="attribute"/>
    </visualBlock>
    <visualExpression kind="FIELD_EXISTS" fieldName="name"/>
  </validations>
  <validations type="REQUIRED" name="Log_message_required" ownerType="Log" fieldName="message" fieldKind="attribute">
    <visualBlock blocklyBlockType="validation_required_field">
      <fields name="TYPE" value="Log"/>
      <fields name="FIELD" value="message"/>
      <fields name="FIELD_KIND" value="attribute"/>
    </visualBlock>
    <visualExpression kind="FIELD_EXISTS" fieldName="message"/>
  </validations>
  <validations type="REQUIRED" name="Wait_milliseconds_required" ownerType="Wait" fieldName="milliseconds" fieldKind="attribute">
    <visualBlock blocklyBlockType="validation_required_field">
      <fields name="TYPE" value="Wait"/>
      <fields name="FIELD" value="milliseconds"/>
      <fields name="FIELD_KIND" value="attribute"/>
    </visualBlock>
    <visualExpression kind="FIELD_EXISTS" fieldName="milliseconds"/>
  </validations>
  <workspaceOptions key="zoom" valueType="OBJECT">
    <children key="controls" value="true" valueType="BOOLEAN"/>
    <children key="maxScale" value="3" valueType="INTEGER"/>
    <children key="startScale" value="1" valueType="INTEGER"/>
  </workspaceOptions>
  <workspaceOptions key="renderer" value="zelos"/>
  <workspaceOptions key="trashcan" value="true" valueType="BOOLEAN"/>
  <workspaceOptions key="grid" valueType="OBJECT">
    <children key="snap" value="true" valueType="BOOLEAN"/>
    <children key="spacing" value="24" valueType="INTEGER"/>
  </workspaceOptions>
</blocklyspec:EditorSpec>
