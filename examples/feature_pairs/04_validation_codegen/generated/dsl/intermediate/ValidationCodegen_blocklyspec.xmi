<?xml version="1.0" encoding="UTF-8"?>
<blocklyspec:EditorSpec xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:blocklyspec="http://www.example.org/model2blockly/intermediate/BlocklyEditorSpec" domainName="ValidationCodegen" nsURI="http://www.example.org/validationcodegen" nsPrefix="validationcodegen" toolboxType="flyout" codeLanguage="javascript" codeFileExtension="js" runtimeKind="workflow">
  <categories name="Pages" label="Pages" colour="260"/>
  <categories name="Actions" label="Actions" colour="30"/>
  <categories name="Expressions" label="Expressions" colour="230"/>
  <blockTypes typeName="Page" label="Page" colour="260" categoryName="Pages" connectionType="NONE" inputsInline="false" codeTemplate="page({{title}}, [{{statements:actions}}]);" idFieldName="pageId">
    <orderedInputNames>pageId</orderedInputNames>
    <orderedInputNames>title</orderedInputNames>
    <orderedInputNames>route</orderedInputNames>
    <orderedInputNames>actions</orderedInputNames>
    <fields name="pageId" defaultValue="page-1" required="true" lowerBound="1" id="true"/>
    <fields name="title" defaultValue="Home" required="true" lowerBound="1"/>
    <fields name="route" defaultValue="/home" required="true" lowerBound="1"/>
    <statementInputs name="actions" checkType="Action" lowerBound="1" upperBound="4"/>
  </blockTypes>
  <blockTypes typeName="Action" label="Action" colour="30" categoryName="Actions" abstract="true" connectionType="TYPED" connectionTypeName="Action" inputsInline="false"/>
  <blockTypes typeName="Alert" label="Alert" colour="30" categoryName="Actions" superTypeName="Action" connectionType="TYPED" connectionTypeName="Action" inputsInline="false" codeTemplate="alert({{message}});">
    <orderedInputNames>message</orderedInputNames>
    <fields name="message" defaultValue="Saved" required="true" lowerBound="1"/>
  </blockTypes>
  <blockTypes typeName="Navigate" label="Navigate" colour="30" categoryName="Actions" superTypeName="Action" connectionType="TYPED" connectionTypeName="Action" inputsInline="false" codeTemplate="navigate({{target}});">
    <orderedInputNames>target</orderedInputNames>
    <referenceFields name="target" targetTypeName="Page" required="true" lowerBound="1" uiWidget="reference-select" uiLabel="Target page" uiOrder="1" uiVariant="default" referenceLabelField="title"/>
  </blockTypes>
  <blockTypes typeName="BooleanLiteral" label="BooleanLiteral" colour="230" categoryName="Expressions" connectionType="OUTPUT" outputType="BooleanLiteral" inputsInline="false" codeTemplate="{{literal}}">
    <orderedInputNames>literal</orderedInputNames>
    <fields name="literal" fieldType="BOOLEAN" defaultValue="true"/>
  </blockTypes>
  <validations type="EXPRESSION" name="Page_titlePresent" ownerType="Page" expression="has('title')" message="Page title is required.">
    <visualBlock blocklyBlockType="validation_expression_rule">
      <fields name="TYPE" value="Page"/>
      <fields name="EXPRESSION" value="has('title')"/>
      <inputs name="CONDITION">
        <expression kind="FIELD_EXISTS" fieldName="title"/>
      </inputs>
    </visualBlock>
    <visualExpression kind="FIELD_EXISTS" fieldName="title"/>
  </validations>
  <validations type="EXPRESSION" name="Page_routeStartsSlash" ownerType="Page" expression="value('route').startsWith('/')" message="Route must start with /.">
    <visualBlock blocklyBlockType="validation_expression_rule">
      <fields name="TYPE" value="Page"/>
      <fields name="EXPRESSION" value="value('route').startsWith('/')"/>
    </visualBlock>
  </validations>
  <validations type="EXPRESSION" name="Page_actionsWithinLimit" ownerType="Page" expression="size('actions') &lt;= 4" message="A page supports at most four actions.">
    <visualBlock blocklyBlockType="validation_expression_rule">
      <fields name="TYPE" value="Page"/>
      <fields name="EXPRESSION" value="size('actions') &lt;= 4"/>
      <inputs name="CONDITION">
        <expression kind="LOGIC_COMPARE" operator="LTE">
          <children kind="INPUT_COUNT" fieldName="actions"/>
          <children kind="NUMBER_LITERAL" literal="4"/>
        </expression>
      </inputs>
    </visualBlock>
    <visualExpression kind="LOGIC_COMPARE" operator="LTE">
      <children kind="INPUT_COUNT" fieldName="actions"/>
      <children kind="NUMBER_LITERAL" literal="4"/>
    </visualExpression>
  </validations>
  <validations type="EXPRESSION" name="Page_HasActions" ownerType="Page" expression="size(&quot;actions&quot;) >= 1" message="Constraint &quot;HasActions&quot; is violated on Page.">
    <visualBlock blocklyBlockType="validation_expression_rule">
      <fields name="TYPE" value="Page"/>
      <fields name="EXPRESSION" value="size(&quot;actions&quot;) >= 1"/>
      <inputs name="CONDITION">
        <expression kind="LOGIC_COMPARE" operator="GTE">
          <children kind="INPUT_COUNT" fieldName="actions"/>
          <children kind="NUMBER_LITERAL" literal="1"/>
        </expression>
      </inputs>
    </visualBlock>
    <visualExpression kind="LOGIC_COMPARE" operator="GTE">
      <children kind="INPUT_COUNT" fieldName="actions"/>
      <children kind="NUMBER_LITERAL" literal="1"/>
    </visualExpression>
  </validations>
  <validations name="Navigate_after_Alert" targetType="Navigate" predecessorType="Alert">
    <visualBlock blocklyBlockType="validation_previous_block_is">
      <fields name="TARGET" value="Navigate"/>
      <fields name="TYPE" value="Alert"/>
    </visualBlock>
    <visualExpression kind="PREVIOUS_BLOCK_IS" typeName="Alert"/>
  </validations>
  <validations type="CARDINALITY" name="Page_actions" ownerType="Page" containmentName="actions" lowerBound="1" upperBound="4">
    <visualBlock blocklyBlockType="validation_statement_cardinality">
      <fields name="TYPE" value="Page"/>
      <fields name="INPUT" value="actions"/>
      <fields name="MIN" value="1"/>
      <fields name="MAX" value="4"/>
    </visualBlock>
    <visualExpression operator="AND">
      <children kind="LOGIC_COMPARE" operator="GTE">
        <children kind="INPUT_COUNT" fieldName="actions"/>
        <children kind="NUMBER_LITERAL" literal="1"/>
      </children>
      <children kind="LOGIC_COMPARE" operator="LTE">
        <children kind="INPUT_COUNT" fieldName="actions"/>
        <children kind="NUMBER_LITERAL" literal="4"/>
      </children>
    </visualExpression>
  </validations>
  <validations type="REQUIRED" name="Page_pageId_required" ownerType="Page" fieldName="pageId" fieldKind="attribute">
    <visualBlock blocklyBlockType="validation_required_field">
      <fields name="TYPE" value="Page"/>
      <fields name="FIELD" value="pageId"/>
      <fields name="FIELD_KIND" value="attribute"/>
    </visualBlock>
    <visualExpression kind="FIELD_EXISTS" fieldName="pageId"/>
  </validations>
  <validations type="REQUIRED" name="Page_title_required" ownerType="Page" fieldName="title" fieldKind="attribute">
    <visualBlock blocklyBlockType="validation_required_field">
      <fields name="TYPE" value="Page"/>
      <fields name="FIELD" value="title"/>
      <fields name="FIELD_KIND" value="attribute"/>
    </visualBlock>
    <visualExpression kind="FIELD_EXISTS" fieldName="title"/>
  </validations>
  <validations type="REQUIRED" name="Page_route_required" ownerType="Page" fieldName="route" fieldKind="attribute">
    <visualBlock blocklyBlockType="validation_required_field">
      <fields name="TYPE" value="Page"/>
      <fields name="FIELD" value="route"/>
      <fields name="FIELD_KIND" value="attribute"/>
    </visualBlock>
    <visualExpression kind="FIELD_EXISTS" fieldName="route"/>
  </validations>
  <validations type="REQUIRED" name="Alert_message_required" ownerType="Alert" fieldName="message" fieldKind="attribute">
    <visualBlock blocklyBlockType="validation_required_field">
      <fields name="TYPE" value="Alert"/>
      <fields name="FIELD" value="message"/>
      <fields name="FIELD_KIND" value="attribute"/>
    </visualBlock>
    <visualExpression kind="FIELD_EXISTS" fieldName="message"/>
  </validations>
  <validations type="REQUIRED" name="Navigate_target_required" ownerType="Navigate" fieldName="target" fieldKind="reference">
    <visualBlock blocklyBlockType="validation_required_field">
      <fields name="TYPE" value="Navigate"/>
      <fields name="FIELD" value="target"/>
      <fields name="FIELD_KIND" value="reference"/>
    </visualBlock>
    <visualExpression kind="FIELD_EXISTS" fieldName="target"/>
  </validations>
  <validations type="UNIQUE" name="Page_pageId_unique" ownerType="Page" fieldName="pageId" fieldKind="id">
    <visualBlock blocklyBlockType="validation_type_field_unique">
      <fields name="TYPE" value="Page"/>
      <fields name="FIELD" value="pageId"/>
    </visualBlock>
    <visualExpression kind="TYPE_FIELD_UNIQUE" fieldName="pageId" typeName="Page"/>
  </validations>
  <workspaceOptions key="zoom" valueType="OBJECT">
    <children key="controls" value="true" valueType="BOOLEAN"/>
    <children key="maxScale" value="3" valueType="INTEGER"/>
    <children key="startScale" value="1" valueType="INTEGER"/>
  </workspaceOptions>
  <workspaceOptions key="renderer" value="zelos"/>
  <workspaceOptions key="trashcan" value="true" valueType="BOOLEAN"/>
  <workspaceOptions key="grid" valueType="OBJECT">
    <children key="snap" value="true" valueType="BOOLEAN"/>
    <children key="spacing" value="24" valueType="INTEGER"/>
  </workspaceOptions>
</blocklyspec:EditorSpec>
