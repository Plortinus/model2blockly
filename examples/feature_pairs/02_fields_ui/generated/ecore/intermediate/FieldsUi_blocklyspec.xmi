<?xml version="1.0" encoding="UTF-8"?>
<blocklyspec:EditorSpec xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:blocklyspec="http://www.example.org/model2blockly/intermediate/BlocklyEditorSpec" domainName="FieldsUi" nsURI="http://www.example.org/fieldsui" nsPrefix="fieldsui" codeLanguage="text" codeFileExtension="txt">
  <categories name="UI" label="UI" colour="180">
    <children name="Content" label="Content" colour="180"/>
    <children name="Appearance" label="Appearance" colour="45"/>
  </categories>
  <blockTypes typeName="ContentForm" label="Content form" colour="180" categoryName="Content" inputsInline="false" tooltip="Content and control field examples.">
    <orderedInputNames>title</orderedInputNames>
    <orderedInputNames>description</orderedInputNames>
    <orderedInputNames>quantity</orderedInputNames>
    <orderedInputNames>opacity</orderedInputNames>
    <orderedInputNames>enabled</orderedInputNames>
    <orderedInputNames>confirmed</orderedInputNames>
    <orderedInputNames>mode</orderedInputNames>
    <orderedInputNames>alignment</orderedInputNames>
    <orderedInputNames>tags</orderedInputNames>
    <orderedInputNames>internalCode</orderedInputNames>
    <fields name="title" defaultValue="Welcome" required="true" lowerBound="1" uiWidget="text" uiLabel="Title" uiHelp="Heading shown to the user." uiPlaceholder="Enter a heading" uiGroup="Content" uiOrder="1" uiVariant="prominent"/>
    <fields name="description" defaultValue="Short description" uiWidget="textarea" uiLabel="Description" uiGroup="Content" uiOrder="2" uiVariant="default"/>
    <fields name="quantity" fieldType="INTEGER" defaultValue="3" min="0" max="10" uiWidget="number" uiLabel="Quantity" uiGroup="Controls" uiOrder="3" uiReadonly="true" uiVariant="default"/>
    <fields name="opacity" fieldType="FLOAT" defaultValue="0.75" min="0" max="1" uiWidget="slider" uiLabel="Opacity" uiGroup="Appearance" uiOrder="4" uiVariant="compact"/>
    <fields name="enabled" fieldType="BOOLEAN" defaultValue="true" uiWidget="switch" uiLabel="Enabled" uiGroup="Controls" uiOrder="5" uiVariant="default"/>
    <fields name="confirmed" fieldType="BOOLEAN" defaultValue="false" uiWidget="checkbox" uiLabel="Confirmed" uiGroup="Controls" uiOrder="6" uiVariant="default"/>
    <fields name="mode" fieldType="DROPDOWN" defaultValue="simple" uiWidget="select" uiLabel="Mode" uiGroup="Controls" uiOrder="7" uiVariant="default">
      <options value="simple" label="simple"/>
      <options value="advanced" label="advanced"/>
    </fields>
    <fields name="alignment" fieldType="DROPDOWN" defaultValue="left" uiWidget="radio" uiLabel="Alignment" uiGroup="Appearance" uiOrder="8" uiVariant="default">
      <options value="left" label="left"/>
      <options value="center" label="center"/>
      <options value="right" label="right"/>
    </fields>
    <fields name="tags" defaultValue="new,featured" required="true" lowerBound="1" upperBound="3" uiWidget="text" uiLabel="Tags" uiHelp="Labels used to describe the form." uiGroup="Content" uiOrder="9" uiVariant="compact"/>
    <fields name="internalCode" defaultValue="FORM-01" uiWidget="text" uiLabel="Internal code" uiGroup="System" uiOrder="10" uiHidden="true" uiVariant="default"/>
  </blockTypes>
  <blockTypes typeName="VisualFields" label="Visual fields" colour="45" categoryName="Appearance" message0="visual fields colour %1 angle %2 image %3 label %4" inputsInline="false" tooltip="Direct colour, angle, image, and label field mappings." helpUrl="https://developers.google.com/blockly">
    <orderedInputNames>colourValue</orderedInputNames>
    <orderedInputNames>angleValue</orderedInputNames>
    <orderedInputNames>imageValue</orderedInputNames>
    <orderedInputNames>labelValue</orderedInputNames>
    <fields name="colourValue" fieldType="COLOUR" defaultValue="#1f6feb"/>
    <fields name="angleValue" fieldType="ANGLE" defaultValue="45"/>
    <fields name="imageValue" fieldType="IMAGE" imageUrl="https://developers.google.com/blockly/images/logos/logo_built_on.svg" imageWidth="32" imageHeight="32" imageAlt="Blockly"/>
    <fields name="labelValue" fieldType="LABEL" defaultValue="Label"/>
  </blockTypes>
  <validations type="REQUIRED" name="ContentForm_title_required" ownerType="ContentForm" fieldName="title" fieldKind="attribute">
    <visualBlock blocklyBlockType="validation_required_field">
      <fields name="TYPE" value="ContentForm"/>
      <fields name="FIELD" value="title"/>
      <fields name="FIELD_KIND" value="attribute"/>
    </visualBlock>
    <visualExpression kind="FIELD_EXISTS" fieldName="title"/>
  </validations>
  <validations type="REQUIRED" name="ContentForm_tags_required" ownerType="ContentForm" fieldName="tags" fieldKind="attribute">
    <visualBlock blocklyBlockType="validation_required_field">
      <fields name="TYPE" value="ContentForm"/>
      <fields name="FIELD" value="tags"/>
      <fields name="FIELD_KIND" value="attribute"/>
    </visualBlock>
    <visualExpression kind="FIELD_EXISTS" fieldName="tags"/>
  </validations>
  <validations type="FIELD_CARDINALITY" name="ContentForm_tags_cardinality" ownerType="ContentForm" lowerBound="1" upperBound="3" fieldName="tags" fieldKind="attribute">
    <visualBlock blocklyBlockType="validation_field_cardinality">
      <fields name="TYPE" value="ContentForm"/>
      <fields name="FIELD" value="tags"/>
      <fields name="FIELD_KIND" value="attribute"/>
      <fields name="MIN" value="1"/>
      <fields name="MAX" value="3"/>
    </visualBlock>
    <visualExpression operator="AND">
      <children kind="LOGIC_COMPARE" operator="GTE">
        <children kind="FIELD_COUNT" fieldName="tags"/>
        <children kind="NUMBER_LITERAL" literal="1"/>
      </children>
      <children kind="LOGIC_COMPARE" operator="LTE">
        <children kind="FIELD_COUNT" fieldName="tags"/>
        <children kind="NUMBER_LITERAL" literal="3"/>
      </children>
    </visualExpression>
  </validations>
  <validations type="UNIQUE" name="ContentForm_tags_unique" ownerType="ContentForm" fieldName="tags" fieldKind="attribute">
    <visualBlock blocklyBlockType="validation_field_unique">
      <fields name="TYPE" value="ContentForm"/>
      <fields name="FIELD" value="tags"/>
      <fields name="FIELD_KIND" value="attribute"/>
    </visualBlock>
    <visualExpression kind="FIELD_UNIQUE" fieldName="tags"/>
  </validations>
</blocklyspec:EditorSpec>
